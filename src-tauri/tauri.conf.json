{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "5e Manager",
  "version": "0.1.86",
  "identifier": "com.tecmat.emanager",
  "build": {
    "beforeDevCommand": "npm run dev -w @dnd5e/web",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build -w @dnd5e/web",
    "frontendDist": "../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "5e Manager — D&D 5e",
        "width": 1100,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
