# 5e Manager — variabili d'ambiente per docker compose (copia in .env e modifica)

# dominio pubblico per la versione HTTPS con nginx (docker-compose.nginx.yml)
# record A del dominio -> IP del server. Es: dnd.tuosito.it
DND5E_DOMAIN=dnd.example.com

# token admin del pannello /admin — IMPOSTALO SEMPRE in produzione (protegge admin e self-update)
DND5E_ADMIN_TOKEN=cambia-questo-token-lungo-e-casuale

# porta HTTP publicada dal compose base (HTTP/LAN)
PORT=3001

# opzionale: token GitHub solo se il repo fosse privato (check-update in-app)
# GITHUB_TOKEN=
