# 5e Manager — .env PRECOMPILATO (pronto all'uso).
# Puoi lasciarlo così per la modalità LAN/HTTP; per esporlo su Internet con HTTPS
# cambia solo DND5E_DOMAIN e metti i certificati in docker/certs/.

# porta HTTP publicada dal server (compose base, HTTP/LAN)
PORT=3001

# dominio pubblico per la modalità HTTPS con nginx (docker-compose.nginx.yml).
# Deve puntare (record A) all'IP pubblico del server. Esempio:
DND5E_DOMAIN=dnd.example.com

# token admin del pannello /admin e del self-update: CAMBIALO con uno tuo
# (es. lunga stringa casuale). In LAN fidata puoi lasciarlo vuoto, in produzione NO.
DND5E_ADMIN_TOKEN=cambia-questo-token-prima-di-esporlo-su-internet

# opzionale: token GitHub solo se il repo fosse privato (check-update in-app)
# GITHUB_TOKEN=
