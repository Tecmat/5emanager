# 5e Manager dietro nginx (HTTPS). L'immagine nginx ufficiale applica envsubst a questo
# template usando solo le variabili d'ambiente definite (DND5E_DOMAIN), quindi le variabili
# nginx ($host, $http_upgrade, ...) restano intatte.
#
# Certificati: metti fullchain.pem e privkey.pem in docker/certs/ (montata in /etc/nginx/certs).
# Con certbot:  certbot certonly --webroot -w /var/www/certbot -d <dominio>  (oppure il tuo gestore)

server {
    listen 80;
    server_name ${DND5E_DOMAIN};

    # challenge ACME di Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DND5E_DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://5emanager:3001;
        proxy_http_version 1.1;
        # WebSocket (multiplayer wss://) — l'upgrade passa in automatico
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
